<?xml version="1.0" encoding="UTF-8"?>
<flowgorithm fileversion="2.11">
  <attributes>
    <attribute name="name" value="Préstamo bancario" />
    <attribute name="authors" value="" />
    <attribute name="about" value="Evalúa si se aprueba un préstamo: el sueldo debe ser mayor al triple de la mensualidad, la antigüedad laboral mayor a dos años y no debe haber deudas vencidas. Informa todos los motivos de rechazo." />
    <attribute name="saved" value="2026-11-10 06:20:00 AM" />
  </attributes>
  <function name="Main" type="None" variable="">
    <parameters />
    <body>
      <declare name="sueldo" type="Real" array="False" size="" />
      <declare name="mensualidad" type="Real" array="False" size="" />
      <declare name="antiguedad" type="Real" array="False" size="" />
      <declare name="deudasVencidas" type="String" array="False" size="" />
      <declare name="rechazado" type="Integer" array="False" size="" />

      <output expression="&quot;Ingrese el sueldo mensual:&quot;" newline="True" />
      <input variable="sueldo" />
      <output expression="&quot;Ingrese la mensualidad del préstamo solicitado:&quot;" newline="True" />
      <input variable="mensualidad" />
      <output expression="&quot;¿Cuántos años de antigüedad laboral tiene?&quot;" newline="True" />
      <input variable="antiguedad" />
      <output expression="&quot;¿Tiene deudas vencidas? Responda s o n:&quot;" newline="True" />
      <input variable="deudasVencidas" />

      <if expression="sueldo &lt;= 0 or mensualidad &lt;= 0 or antiguedad &lt; 0">
        <then>
          <output expression="&quot;Error: el sueldo y la mensualidad deben ser mayores que cero; la antigüedad no puede ser negativa.&quot;" newline="True" />
        </then>
        <else>
          <if expression="deudasVencidas != &quot;s&quot; and deudasVencidas != &quot;S&quot; and deudasVencidas != &quot;n&quot; and deudasVencidas != &quot;N&quot;">
            <then>
              <output expression="&quot;Error: responda s para sí o n para no.&quot;" newline="True" />
            </then>
            <else>
              <assign variable="rechazado" expression="0" />

              <if expression="sueldo &lt;= mensualidad * 3">
                <then>
                  <assign variable="rechazado" expression="1" />
                  <output expression="&quot;Motivo de rechazo: el sueldo mensual debe ser mayor que el triple de la mensualidad solicitada.&quot;" newline="True" />
                </then>
                <else />
              </if>

              <if expression="antiguedad &lt;= 2">
                <then>
                  <assign variable="rechazado" expression="1" />
                  <output expression="&quot;Motivo de rechazo: se requiere más de 2 años de antigüedad laboral.&quot;" newline="True" />
                </then>
                <else />
              </if>

              <if expression="deudasVencidas = &quot;s&quot; or deudasVencidas = &quot;S&quot;">
                <then>
                  <assign variable="rechazado" expression="1" />
                  <output expression="&quot;Motivo de rechazo: la persona tiene deudas vencidas.&quot;" newline="True" />
                </then>
                <else />
              </if>

              <if expression="rechazado = 0">
                <then>
                  <output expression="&quot;Préstamo aprobado. La persona cumple con todos los requisitos.&quot;" newline="True" />
                </then>
                <else>
                  <output expression="&quot;Préstamo rechazado.&quot;" newline="True" />
                </else>
              </if>
            </else>
          </if>
        </else>
      </if>
    </body>
  </function>
</flowgorithm>
