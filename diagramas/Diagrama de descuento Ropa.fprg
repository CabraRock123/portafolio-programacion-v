<?xml version='1.0' encoding='UTF-8'?>
<flowgorithm fileversion="2.11"><attributes><attribute name="name" value="Descuento en una tienda de ropa" /><attribute name="authors" value="" /><attribute name="about" value="Calcula el descuento y el total a pagar según el monto de compra, la tarjeta de lealtad y la temporada de rebajas." /><attribute name="saved" value="2026-11-10 06:10:00 AM" /></attributes><function name="Main" type="None" variable=""><parameters /><body><declare name="montoCompra" type="Real" array="False" size="" /><declare name="tarjetaLealtad" type="String" array="False" size="" /><declare name="temporadaRebajas" type="String" array="False" size="" /><declare name="descuento" type="Real" array="False" size="" /><declare name="montoDescuento" type="Real" array="False" size="" /><declare name="totalPagar" type="Real" array="False" size="" /><output expression="&quot;Ingrese el monto de la compra:&quot;" newline="True" /><input variable="montoCompra" /><output expression="&quot;¿Tiene tarjeta de lealtad? Escriba si o no:&quot;" newline="True" /><input variable="tarjetaLealtad" /><output expression="&quot;¿Es temporada de rebajas? Escriba si o no:&quot;" newline="True" /><input variable="temporadaRebajas" /><if expression="montoCompra &lt;= 0"><then><output expression="&quot;Error: el monto de compra debe ser mayor que cero.&quot;" newline="True" /></then><else><if expression="tarjetaLealtad = &quot;si&quot;"><then><if expression="temporadaRebajas = &quot;si&quot;"><then><assign variable="descuento" expression="0.30" /></then><else><assign variable="descuento" expression="0.10" /></else></if></then><else><if expression="temporadaRebajas = &quot;si&quot;"><then><assign variable="descuento" expression="0.20" /></then><else><assign variable="descuento" expression="0" /></else></if></else></if><assign variable="montoDescuento" expression="montoCompra * descuento" /><assign variable="totalPagar" expression="montoCompra - montoDescuento" /><output expression="&quot;Descuento aplicado (%):&quot;" newline="True" /><output expression="descuento * 100" newline="True" /><output expression="&quot;Ahorro en dinero:&quot;" newline="True" /><output expression="montoDescuento" newline="True" /><output expression="&quot;Total a pagar:&quot;" newline="True" /><output expression="totalPagar" newline="True" /></else></if></body></function></flowgorithm>